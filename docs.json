            "pages": [
              "api/overview",
              "api/auth",
              "api/routes",
              "api/locations",
              "api/reports"
            ]
          },
          {
            "group": "Core operations",
            "pages": [
              "api/sales",
              "api/budgets",
              "api/scheduling",
              "api/inventory",
              "api/pos"
            ]
          },
          {
            "group": "Platform APIs",
            "pages": [
              "api/integrations",
              "api/webhooks",
              "api/messaging",
              "api/billing",
              "api/commissary",
              "api/reservations",
